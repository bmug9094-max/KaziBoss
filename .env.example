# --- Supabase (optionnel : sans ces valeurs, l'app tourne en mode Invité / Démo locale) ---
# Supabase › Project Settings › API : « Project URL » et clé « anon / publishable » (jamais la service_role).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Liens de paiement Chariow directs (SECOURS uniquement) ---
# Le paiement normal passe par l'Edge Function `create-checkout` (voir README).
# Ces liens servent si la fonction est indisponible ; l'achat est alors rattaché
# au compte grâce à l'email (bouton « Restaurer mes achats »).
# Pour les ressources Digital Growth, le lien permet aussi d'acheter sans compte.
VITE_CHARIOW_AGRI_URL=
VITE_CHARIOW_UNLIMITED_URL=
VITE_CHARIOW_RESOURCES_URL=

# Les secrets serveur (clé API Chariow, secret de signature, ids produits) ne vont PAS ici :
# ils se règlent avec `supabase secrets set` (voir README › Paiements).
